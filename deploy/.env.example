# Copy to .env and fill in. Never commit .env.

# Your CleanStream address, without https:// (for example familyskips.duckdns.org)
DOMAIN=

# Your own TMDB API key (themoviedb.org > Settings > API > "API Key")
TMDB_API_KEY=

# Long random secrets. Create them with:  openssl rand -hex 32
POSTGRES_PASSWORD=
CLEANSTREAM_VOTE_SALT=

# Password for the moderation page (https://<your address>/admin). Also: openssl rand -hex 32
ADMIN_TOKEN=

# Automatic imports, saved as unconfirmed skips: VideoSkip daily, public CleanStream on Sundays.
# Set DAILY_IMPORT=off to turn them off. The hour is in UTC.
DAILY_IMPORT=on
DAILY_IMPORT_HOUR_UTC=3

# Country used for digital release dates (US, GB, SA, ...)
DIGITAL_RELEASE_REGION=US

# Local port for the app (only change it if 7000 is already used on the server)
CLEANSTREAM_PORT=7000
