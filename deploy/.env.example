# Copy to .env and fill in. Never commit .env.

# Your CleanStream domain, without https:// (for example cleanstream.example.com)
DOMAIN=

# Your own TMDB API key (themoviedb.org > Settings > API > "API Key")
TMDB_API_KEY=

# Long random secrets. Create them with:  openssl rand -hex 32
POSTGRES_PASSWORD=
CLEANSTREAM_VOTE_SALT=

# Country used for digital release dates (US, GB, SA, ...)
DIGITAL_RELEASE_REGION=US

# Local port for the app (only change it if 7000 is already used on the server)
CLEANSTREAM_PORT=7000
